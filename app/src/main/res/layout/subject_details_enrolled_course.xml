<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/coursesbg"
        android:padding="16dp"
        tools:layout_editor_absoluteX="182dp"
        tools:layout_editor_absoluteY="0dp"
        android:scrollbars="none"
        >


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Course Title -->

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="170dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:src="@drawable/back"
                />

            <TextView
                android:id="@+id/tvCourseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/subject_title"
                android:textColor="@android:color/black"
                android:textSize="27sp"
                android:textStyle="bold" />


            <!-- Instructor Card -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:padding="20dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivInstructor"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="16dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvInstructorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prof. Chessi Kallen"
                            android:textColor="@android:color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvInstructorEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/prof_email"
                            android:textColor="#191919"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- Course Overview Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:elevation="10dp"
                android:padding="16dp"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:background="#807653EC"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingLeft="15dp"
                        android:paddingTop="5dp"
                        android:text="@string/course_overview"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCourseOverview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_outline"
                        android:padding="15dp"
                        android:text="@string/course_overview_desc"
                        android:textColor="#5F5F5F"
                        android:textSize="13sp" />
                </LinearLayout>


            </androidx.cardview.widget.CardView>




            <!-- Requirements Card -->
<!--            <androidx.cardview.widget.CardView-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginTop="25dp"-->
<!--                android:elevation="3dp"-->
<!--                android:padding="16dp"-->
<!--                app:cardCornerRadius="10dp">-->

<!--                <LinearLayout-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:orientation="vertical">-->

<!--                    <TextView-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="30dp"-->
<!--                        android:background="#807653EC"-->
<!--                        android:fontFamily="@font/poppins_medium"-->
<!--                        android:paddingLeft="15dp"-->
<!--                        android:paddingTop="5dp"-->
<!--                        android:text="@string/requirements_prerequisites"-->
<!--                        android:textColor="@color/black"-->
<!--                        android:textSize="12sp"-->
<!--                        android:textStyle="bold" />-->

<!--                    <TextView-->
<!--                        android:id="@+id/tvRequirements"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:padding="15dp"-->
<!--                        android:text="@string/requirements_desc"-->
<!--                        android:textColor="#5F5F5F"-->
<!--                        android:textSize="13sp"-->
<!--                        android:background="@drawable/card_outline"/>-->
<!--                </LinearLayout>-->

<!--            </androidx.cardview.widget.CardView>-->


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="25dp"
                android:elevation="3dp"
                android:padding="16dp"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFF2FF"
                    android:padding="0dp">

                    <!-- Header -->


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:background="#807653EC"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingLeft="15dp"
                        android:paddingTop="5dp"
                        android:text="Topic Overview"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center_vertical"/>

                    <!-- Topic Items -->
                    <!-- Item 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#EDEDED"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:paddingStart="20dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Introduction to DSA"
                            android:textSize="14sp"
                            android:textColor="#000000" />
                    </LinearLayout>

                    <!-- Item 2 with bookmark -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F6F6F6"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Arrays"
                            android:textSize="14sp"
                            android:textColor="#000000"
                            />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_bookmark" />
                    </LinearLayout>

                    <!-- Item 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#EDEDED"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Linked Lists"
                            android:textSize="14sp"
                            android:textColor="#000000" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>




            <!-- Outer Card (Task Card) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:elevation="3dp"
                android:padding="16dp"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white">

                    <!-- Header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:background="#D3A4F4"
                        android:fontFamily="@font/poppins_medium"
                        android:padding="6dp"
                        android:paddingStart="20dp"
                        android:text="Task"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Begin: Quiz Info as Individual Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:elevation="2dp"
                        android:padding="10dp"
                        app:cardCornerRadius="10dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@android:color/white">

                            <!-- Quiz Title -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="start|center_vertical"
                                android:layout_marginBottom="5dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/task_icon"
                                    android:layout_marginEnd="6dp"
                                    android:tint="#000000" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Programming Assignment #3"
                                    android:textColor="#000000"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>

                            <!-- Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="5dp"
                                android:background="#000000"
                                android:layout_marginBottom="10dp" />

                            <!-- Footer -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:gravity="end|center_vertical"
                                android:layout_marginBottom="5dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.9"
                                    android:orientation="horizontal"
                                    android:gravity="start|center_vertical">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/due_icon"
                                        android:tint="#4CAF50"
                                        android:layout_marginEnd="3dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Completed on April 2 2025"
                                        android:textColor="#4CAF50"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/poppins_medium" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Score: 8 / 10"
                                    android:textColor="#D877DD"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/poppins_medium" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <!-- End: Quiz Info Card -->

                    <!--     task 2               -->

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:padding="10dp"
                        app:cardCornerRadius="5dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/dash_border">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@android:color/white">

                            <!-- Quiz Title -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="start|center_vertical"
                                android:layout_marginBottom="5dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/task_icon"
                                    android:layout_marginEnd="6dp"
                                    android:tint="#000000" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Programming Assignment #3"
                                    android:textColor="#000000"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins_regular" />
                            </LinearLayout>

                            <!-- Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="5dp"
                                android:background="#000000"
                                android:layout_marginBottom="10dp" />

                            <!-- Footer -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:gravity="end|center_vertical"
                                android:layout_marginBottom="5dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.9"
                                    android:orientation="horizontal"
                                    android:gravity="start|center_vertical">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/due_icon"
                                        android:tint="#4CAF50"
                                        android:layout_marginEnd="3dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Completed on April 2 2025"
                                        android:textColor="#4CAF50"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/poppins_medium" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Score: 8 / 10"
                                    android:textColor="#D877DD"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/poppins_medium" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="50dp"
                android:elevation="3dp"
                android:padding="16dp"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white">

                    <!-- Header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:background="#D3A4F4"
                        android:fontFamily="@font/poppins_medium"
                        android:padding="6dp"
                        android:paddingStart="20dp"
                        android:text="Quizzes"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- First Quiz Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:elevation="2dp"
                        android:padding="10dp"
                        app:cardCornerRadius="10dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@android:color/white">



                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Once an answer is submitted, you cannot go back. Answer carefully before proceeding."
                                android:textColor="#777777"
                                android:textSize="12sp"
                                android:lineSpacingExtra="1dp"
                                android:fontFamily="@font/poppins_regular" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:background="#000000" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:gravity="end|center_vertical">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="0.9"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="start|center_vertical">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/due_icon"
                                        android:tint="#FFA500"
                                        android:layout_marginEnd="3dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Due today at 5:00 PM"
                                        android:textColor="#FFA500"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/poppins_medium" />
                                </LinearLayout>

                                <Button
                                    android:layout_width="85dp"
                                    android:layout_height="40dp"
                                    android:text="Start Quiz"
                                    android:textSize="11sp"
                                    android:textColor="@android:color/white"
                                    android:backgroundTint="#D877DD"
                                    android:fontFamily="@font/poppins_medium"
                                    android:textAllCaps="false" />
                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Second Quiz Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:elevation="2dp"
                        android:padding="10dp"
                        app:cardCornerRadius="10dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@android:color/white">



                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Once an answer is submitted, you cannot go back. Answer carefully before proceeding."
                                android:textColor="#777777"
                                android:textSize="12sp"
                                android:lineSpacingExtra="1dp"
                                android:fontFamily="@font/poppins_regular" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:background="#000000" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:gravity="end|center_vertical">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="0.9"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="start|center_vertical">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/score"
                                        android:tint="#3556EA"
                                        android:layout_marginEnd="3dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Score: 40 /70"
                                        android:textColor="#3556EA"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/poppins_medium" />
                                </LinearLayout>

                                <Button
                                    android:layout_width="85dp"
                                    android:layout_height="40dp"
                                    android:text="Review"
                                    android:textSize="11sp"
                                    android:textColor="@android:color/white"
                                    android:backgroundTint="#B388EB"
                                    android:fontFamily="@font/poppins_medium"
                                    android:textAllCaps="false" />
                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>








        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>