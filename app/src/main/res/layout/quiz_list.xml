<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cardview="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:background="#B6BCFF"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:layout_marginTop="65dp"
            android:src="@drawable/back2"
            android:tint="#000000" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="60dp"
            android:layout_toEndOf="@id/backButton"
            android:fontFamily="@font/poppins_medium"
            android:text="Quizzes"
            android:textColor="#000000"
            android:textSize="20sp" />
    </RelativeLayout>

    <!-- Scrollable List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- First Quiz Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="25dp"
                cardview:cardCornerRadius="10dp"
                cardview:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:background="#D3A4F4"
                        android:fontFamily="@font/poppins_medium"
                        android:padding="6dp"
                        android:paddingStart="20dp"
                        android:text="Computer Programming"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp"
                        android:paddingTop="10dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_name"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Once an answer is submitted, you cannot go back. Answer carefully before proceeding."
                            android:textColor="#777777"
                            android:textSize="12sp"
                            android:lineSpacingExtra="1dp"
                            android:fontFamily="@font/poppins_regular" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="5dp"
                            android:background="#000000" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="end|center_vertical"
                            android:layout_marginBottom="-5dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:orientation="horizontal"
                                android:gravity="start|center_vertical">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/due_icon"
                                    android:tint="#FFA500"
                                    android:layout_marginEnd="3dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Due today at 5:00 PM"
                                    android:textColor="#FFA500"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/poppins_medium" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/startQuizButton"
                                android:layout_width="85dp"
                                android:layout_height="40dp"
                                android:text="Start Quiz"
                                android:textSize="11sp"
                                android:textColor="@android:color/white"
                                android:backgroundTint="#D877DD"
                                android:fontFamily="@font/poppins_medium"
                                android:textAllCaps="false"
                                android:paddingLeft="-5dp"
                                android:paddingRight="-5dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Second Quiz Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                cardview:cardCornerRadius="10dp"
                cardview:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:background="#D3A4F4"
                        android:fontFamily="@font/poppins_medium"
                        android:padding="6dp"
                        android:paddingStart="20dp"
                        android:text="Calculus"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp"
                        android:paddingTop="10dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_name"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Once an answer is submitted, you cannot go back. Answer carefully before proceeding."
                            android:textColor="#777777"
                            android:textSize="12sp"
                            android:lineSpacingExtra="1dp"
                            android:fontFamily="@font/poppins_regular" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="5dp"
                            android:background="#000000" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="end|center_vertical"
                            android:layout_marginBottom="-5dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.9"
                                android:orientation="horizontal"
                                android:gravity="start|center_vertical">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/score"
                                    android:tint="#3556EA"
                                    android:layout_marginEnd="3dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Score: 40 /70"
                                    android:textColor="#3556EA"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/poppins_medium" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/reviewQuizButton"
                                android:layout_width="85dp"
                                android:layout_height="40dp"
                                android:text="Review"
                                android:textSize="11sp"
                                android:textColor="@android:color/white"
                                android:backgroundTint="#B388EB"
                                android:fontFamily="@font/poppins_medium"
                                android:textAllCaps="false"
                                android:paddingLeft="-5dp"
                                android:paddingRight="-5dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
