<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@drawable/gradient_background"
    tools:context=".ResultActivity">

    <!-- Title -->
    <TextView
    android:id="@+id/tvSubject"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/course_subject"
    android:textSize="16sp"

    android:layout_marginTop="70dp"
    android:layout_centerHorizontal="true"
    android:textColor="#000000"
    android:fontFamily="@font/poppins_medium"/>

    <!-- Circle Score Background (custom look with drawable or just a static background) -->
    <FrameLayout
        android:id="@+id/circleContainer"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:layout_below="@id/tvSubject"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true">

        <ImageView
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_marginEnd="3dp"
            android:src="@drawable/circle_bg"
            android:tint="#B6BCFF"
            android:layout_marginTop="10dp"
            android:paddingLeft="10dp"/>

        <ProgressBar
            android:id="@+id/progressRing"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="50"
            android:progress="35"
            android:progressDrawable="@drawable/circular_progress_bar"
            android:rotation="90"
            android:background="@android:color/transparent"/>

<!-- Score Text -->
<TextView
    android:id="@+id/tvScore"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="35/50"
    android:textSize="30sp"
    android:textStyle="bold"
    android:layout_gravity="center"
    android:textColor="#000000"
    android:fontFamily="@font/poppins_medium"
    android:backgroundTint=""/>
</FrameLayout>

    <!-- Result Text -->
        <TextView
        android:id="@+id/tvResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Outstanding!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_below="@id/circleContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:textColor="#C77DFF"
        android:fontFamily="@font/poppins_bold"/>

    <!-- Message -->
    <TextView
    android:id="@+id/tvMessage"
    android:layout_width="250dp"
        android:textAlignment="center"
    android:layout_height="wrap_content"
    android:text="You got everything right, our hard work really shows!!"
    android:textSize="14sp"
    android:layout_below="@id/tvResult"
    android:layout_marginTop="8dp"
    android:layout_centerHorizontal="true"
    android:textColor="#B390DA"
    android:fontFamily="@font/poppins_medium"/>

    <!-- Finish Button -->
<Button
android:id="@+id/btnNext"
android:layout_width="250dp"
android:layout_height="wrap_content"
android:layout_alignParentBottom="true"
android:layout_marginTop="8dp"
android:layout_marginBottom="40dp"
android:backgroundTint="#C77DFF"
android:text="Finish"
android:textColor="#FFFFFF"
android:fontFamily="@font/poppins_medium"
android:paddingVertical="10dp"
android:textSize="13sp"
android:layout_centerHorizontal="true"
android:textAllCaps="false"/>
    </RelativeLayout>
