<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#E4E2F5"
    android:padding="16dp">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnNext"
        android:background="#E4E2F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="70dp">

            <!-- Subject and Question Number -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/subjectTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Computer Programming"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:id="@+id/textQuestionNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Question 1 of 5"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Question Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#E4E2F5"
                app:cardElevation="0dp"
               >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- Question -->
                    <TextView
                        android:id="@+id/textQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/question"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_medium" />

                    <!-- Choices -->
                    <LinearLayout
                        android:id="@+id/optionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp"

                        >



                        <Button
                            android:id="@+id/option1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#FFFFFF"
                            android:text="@string/option_1"
                            android:textColor="#000000"
                            android:fontFamily="@font/poppins_medium"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="10dp"
                            android:textSize="13sp"
                            android:gravity="start|center_vertical"
                            android:textAllCaps="false"
                            android:layout_marginBottom="-10dp"

                            />

                        <Button
                            android:id="@+id/option2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#C799F1"
                            android:text="Option 2"
                            android:textColor="#000000"
                            android:fontFamily="@font/poppins_medium"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="10dp"
                            android:textSize="13sp"
                            android:gravity="start|center_vertical"
                            android:textAllCaps="false"
                            android:layout_marginBottom="-10dp"

                            />

                        <Button
                            android:id="@+id/option3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#FFFFFF"
                            android:text="Option 3"
                            android:textColor="#000000"
                            android:fontFamily="@font/poppins_medium"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="10dp"
                            android:textSize="13sp"
                            android:gravity="start|center_vertical"
                            android:textAllCaps="false"
                            android:layout_marginBottom="-10dp"
                            />

                        <Button
                            android:id="@+id/option4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#FFFFFF"
                            android:text="Option 4"
                            android:textColor="#000000"
                            android:fontFamily="@font/poppins_medium"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="10dp"
                            android:textSize="13sp"
                            android:gravity="start|center_vertical"
                            android:textAllCaps="false"
                            />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Fixed Next Button -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#C77DFF"
        android:text="@string/next"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/poppins_medium"
        android:paddingVertical="10dp"
        android:textSize="13sp"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"


        />
</RelativeLayout>
